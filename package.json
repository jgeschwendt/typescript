{
  "name": "jlg",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "ncu": "bunx npm-check-updates -u --workspaces",
    "release": "changeset publish",
    "update": "bunx npm-check-updates -u --workspaces && bun install",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@jlg/oxfmt": "^0.1.1",
    "@jlg/oxlint": "^0.1.3",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004"
  }
}
