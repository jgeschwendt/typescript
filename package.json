{
  "name": "jlg",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "ncu": "bunx npm-check-updates -u --workspaces",
    "release": "changeset publish",
    "update": "bunx npm-check-updates -u --workspaces && bun install",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@jlg/oxfmt": "^0.1.1",
    "@jlg/oxlint": "^0.1.4",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
