{
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002"
  },
  "name": "typescript-monorepo",
  "private": true,
  "scripts": {
    "changeset": "changeset",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives",
    "ncu": "bunx npm-check-updates -u --workspaces",
    "release": "changeset publish",
    "update": "bunx npm-check-updates -u --workspaces && bun install",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "workspaces": [
    "packages/*"
  ]
}
