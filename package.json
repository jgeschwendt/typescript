{
  "name": "jlg",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "format": "bun --bun oxfmt",
    "lint": "bun --bun oxlint --fix",
    "ncu": "bunx npm-check-updates -u --workspaces",
    "release": "changeset publish",
    "update": "bunx npm-check-updates -u --workspaces && bun install",
    "version-packages": "changeset version && bun .changeset/changelog.js packages/*/CHANGELOG.md && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "^4.0.1",
    "@changesets/get-github-info": "^1.0.1",
    "@jlg/dandori": "workspace:*",
    "@jlg/oxfmt": "^0.1.2",
    "@jlg/oxlint": "^0.1.5",
    "@types/bun": "^1.4.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
