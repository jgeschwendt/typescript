{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",

  // Nested config, scoped to this directory (blast radius = packages/oxlint/).
  // A nested config REPLACES the root for its subtree rather than merging with
  // it, so it extends the root (and through it the shipped base) and carries
  // only the relaxations this package's tooling code needs. Not in `files`, so
  // consumers never see it. __tests__/.oxlintrc.json extends this file.
  "extends": ["../../.oxlintrc.json"],

  // The root's ignorePatterns do not carry into a nested scope (nor through
  // `extends`): without this the generated index.d.ts is linted.
  "ignorePatterns": ["**/*.d.ts"],

  // eslint-plugin-react warns on every run without a React version, and
  // `settings` reach the JS plugins only from the nested config governing the
  // file (not from the root, nor through `extends`). No React here: any semver.
  "settings": { "react": { "version": "19.2.0" } },

  "rules": {
    // Every file here runs inside oxlint's Node/Bun process (the config entry,
    // the JS plugins, their tests): there is no browser target to protect.
    "import/no-nodejs-modules": "off"
  },

  "overrides": [
    {
      "files": ["plugins/*.mjs"],
      "rules": {
        // oxlint's `jsPlugins` loader takes a plugin module's default export.
        "import/no-default-export": "off",
        // eslint-module-utils' resolver ignores `exports` maps, and these two
        // packages resolve only through one (no `main`; a subpath export).
        "import-js/no-unresolved": [
          "error",
          {
            "ignore": [
              "^@typescript-eslint/eslint-plugin$",
              "^eslint/use-at-your-own-risk$"
            ]
          }
        ],
        // typescript6.mjs is imported for its side effect (the resolve hook).
        "import/no-unassigned-import": [
          "error",
          { "allow": ["**/typescript6.mjs"] }
        ]
      }
    },
    {
      "files": ["plugins/host.mjs"],
      "rules": {
        // `jsdoc` is ESLint's SourceCode#getJSDocComment verbatim, kept
        // diffable against upstream; its contract returns `null`.
        "max-statements": "off",
        "unicorn/no-null": "off"
      }
    },
    {
      "files": ["plugins/typescript6.mjs"],
      "rules": {
        // Node's CommonJS resolver hook point, the only one Bun routes through.
        "no-underscore-dangle": ["error", { "allow": ["_resolveFilename"] }]
      }
    }
  ]
}
