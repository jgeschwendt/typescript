{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",

  "extends": ["../.oxlintrc.json"],

  "settings": { "react": { "version": "19.2.0" } },

  "rules": {
    // a describe callback holds one statement per test it declares
    "max-statements": "off"
  },

  // an override: the base's JS-files override would beat a top-level rule
  "overrides": [
    {
      "files": ["*.js"],
      "rules": {
        // bun:test is a runtime builtin eslint-module-utils cannot resolve
        "import-js/no-unresolved": ["error", { "ignore": ["^bun:"] }]
      }
    }
  ]
}
