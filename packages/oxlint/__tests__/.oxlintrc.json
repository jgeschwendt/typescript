{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",

  // Nested config, scoped to this directory only (blast radius = __tests__/).
  // Extends the package config (which extends the root and the shipped base),
  // relaxing only what is categorically wrong for test code. Consumers are
  // unaffected.
  "extends": ["../.oxlintrc.json"],

  // eslint-plugin-react warns without a React version; `settings` do not carry
  // through `extends` (see ../.oxlintrc.json).
  "settings": { "react": { "version": "19.2.0" } },

  "rules": {
    // A describe callback holds one statement per test it declares.
    "max-statements": "off"
  },

  // An override, to land after the base's JavaScript-files override that
  // switches import-js/no-unresolved on.
  "overrides": [
    {
      "files": ["*.js"],
      "rules": {
        // bun:test is a runtime builtin, which eslint-module-utils cannot
        // resolve.
        "import-js/no-unresolved": ["error", { "ignore": ["^bun:"] }]
      }
    }
  ]
}
