{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",

  // Nested config, scoped to this directory only (blast radius = __tests__/).
  // The base config is maximalist and type-aware; a handful of its rules are
  // categorically wrong for test + tooling code. Relaxed here rather than in the
  // shipped base or the repo root, so consumers are unaffected. Each disable is
  // justified — nothing is silenced for convenience.
  "rules": {
    // Test files necessarily import Node builtins (node:fs, node:child_process, …).
    "import/no-nodejs-modules": "off",
    // _lib.js is a shared helper: several named exports is the point.
    "import/group-exports": "off",
    // Function declarations read best for these helpers.
    "func-style": "off",
    // Short locals (parse offsets, loop indices) are idiomatic in test helpers.
    "id-length": "off",
    // bun:test's `test()` returns a value that is meant to float.
    "typescript/no-floating-promises": "off",
    // oxlint's own `--rules` JSON and the parsed JSONC config are `any`; the
    // no-unsafe-* family fires on every access. These are external, schema-known
    // shapes read only by the tests.
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-return": "off"
  }
}
