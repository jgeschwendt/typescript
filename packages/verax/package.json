{
  "name": "verax",
  "version": "0.1.1",
  "description": "Truthful data — minimal, GraphQL-shaped runtime types for TypeScript. Standard Schema native.",
  "keywords": [
    "graphql",
    "schema",
    "standard-schema",
    "superstruct",
    "typescript",
    "validation"
  ],
  "homepage": "https://jgeschwendt.github.io/typescript/verax/",
  "bugs": "https://github.com/jgeschwendt/typescript/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgeschwendt/typescript.git",
    "directory": "packages/verax"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdl": {
      "types": "./dist/sdl.d.ts",
      "import": "./dist/sdl.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "bun bench/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "docs": "bun build src/index.ts src/sdl.ts docs/repl.ts --entry-naming [name].[ext] --outdir docs/build --splitting --target browser",
    "prepack": "bun run build",
    "test": "tsc --noEmit && bun --config=../../bunfig.toml test"
  },
  "devDependencies": {
    "@jlg/oxfmt": "^0.1.2",
    "@jlg/oxlint": "^0.1.4",
    "@types/bun": "^1.4.5",
    "fast-check": "^4.11.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
