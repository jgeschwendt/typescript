{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",

  // Nested config, scoped to this directory (blast radius = packages/oxfmt/).
  // A nested config REPLACES the root for its subtree rather than merging with
  // it, so it extends the root (and through it the @jlg/oxlint base) and
  // carries only the relaxations this package's tooling code needs. Not in
  // `files`, so consumers never see it. Mirrors packages/oxlint/.oxlintrc.json;
  // __tests__/.oxlintrc.json extends this file.
  "extends": ["../../.oxlintrc.json"],

  // The root's ignorePatterns do not carry into a nested scope (nor through
  // `extends`): without this the generated index.d.ts is linted.
  "ignorePatterns": ["**/*.d.ts"],

  // eslint-plugin-react warns on every run without a React version, and
  // `settings` reach the JS plugins only from the nested config governing the
  // file (not from the root, nor through `extends`). No React here: any semver.
  "settings": { "react": { "version": "19.2.0" } },

  "rules": {
    // Every file here runs under oxfmt's Node/Bun config loader or bun test:
    // there is no browser target to protect.
    "import/no-nodejs-modules": "off"
  }
}
