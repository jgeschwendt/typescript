{
  "compilerOptions": {
    "declaration": true,
    "lib": ["DOM", "ES2025"],
    "module": "node16",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "target": "esnext"
  }
}
