amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"
hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps {
      ["oxfmt"] {
        check = "bun --bun oxfmt --check --no-error-on-unmatched-pattern {{files}}"
        fix = "bun --bun oxfmt --no-error-on-unmatched-pattern {{files}}"
      }
      ["oxlint"] {
        check = "bun --bun oxlint --no-error-on-unmatched-pattern {{files}}"
        glob = List("*.cjs", "*.cts", "*.js", "*.jsx", "*.mjs", "*.mts", "*.ts", "*.tsx")
      }
    }
  }
  ["pre-push"] {
    steps {
      ["gate"] {
        check = "unset $(git rev-parse --local-env-vars); mise run check"
      }
    }
  }
}
